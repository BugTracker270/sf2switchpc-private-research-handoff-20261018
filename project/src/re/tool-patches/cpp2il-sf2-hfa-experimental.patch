diff --git a/Cpp2IL.Core/Utils/LegacyArm64LeafAccessors.cs b/Cpp2IL.Core/Utils/LegacyArm64LeafAccessors.cs
new file mode 100644
--- /dev/null
+++ b/Cpp2IL.Core/Utils/LegacyArm64LeafAccessors.cs
@@ -0,0 +1,204 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Concurrent;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using Cpp2IL.Core.Model.Contexts;
+using LibCpp2IL.NintendoSwitch;
+
+namespace Cpp2IL.Core.Utils;
+
+/// <summary>
+/// Finds an existing public property accessor only when its complete reachable
+/// native body is one exact scalar field access followed by RET. This does not
+/// change field visibility, manufacture accessors, or recognize effectful getters.
+/// Caller accessibility and recursion checks remain the emitter's responsibility.
+/// </summary>
+public static class LegacyArm64LeafAccessors
+{
+    private sealed record Accessors(MethodAnalysisContext? Getter, MethodAnalysisContext? Setter);
+    private static readonly ConditionalWeakTable<ApplicationAnalysisContext,
+        ConcurrentDictionary<FieldAnalysisContext, Accessors>> Cache = new();
+    private sealed record StaticGetter(MethodAnalysisContext? Getter);
+    private static readonly ConditionalWeakTable<ApplicationAnalysisContext,
+        ConcurrentDictionary<FieldAnalysisContext, StaticGetter>> StaticCache = new();
+
+    public static MethodAnalysisContext? FindStaticGetter(FieldAnalysisContext field)
+    {
+        if (!LegacyArm64ScalarBoxing.Enabled(field.AppContext)) return null;
+        return StaticCache.GetValue(field.AppContext, _ => new()).GetOrAdd(field, f =>
+        {
+            var candidates = f.DeclaringType.Properties.Select(p => p.Getter).Where(m => m != null
+                && IsExactStaticGetter(f, m)).Distinct().ToArray();
+            return new StaticGetter(candidates.Length == 1 ? candidates[0] : null);
+        }).Getter;
+    }
+
+    /// <summary>
+    /// A static getter may contain method-metadata assurance, but no managed
+    /// initializer or game effect. The exact FDE and metadata owner are proved
+    /// separately from the instruction witness; field names are not evidence.
+    /// </summary>
+    public static bool IsExactStaticGetter(FieldAnalysisContext field, MethodAnalysisContext method)
+    {
+        var owner = field.DeclaringType;
+        var app = field.AppContext;
+        if (!LegacyArm64ScalarBoxing.Enabled(app) || !field.IsStatic || field.Offset < 0
+            || (field.Attributes & FieldAttributes.Literal) != 0 || owner.Definition == null
+            || owner.IsValueType || owner.IsEnumType || owner.DeclaringType != null
+            || owner is GenericInstanceTypeAnalysisContext || owner.GenericParameters.Count != 0 || owner.HasAnyGenericParameters()
+            || owner.Definition.PackingSize != 0 || (owner.Attributes & TypeAttributes.VisibilityMask) != TypeAttributes.Public
+            || (owner.Attributes & TypeAttributes.LayoutMask) == TypeAttributes.ExplicitLayout
+            || owner.DeclaringAssembly.Name is not ("Assembly-CSharp" or "Assembly-CSharp-firstpass")
+            || owner.Methods.Any(m => m.Name == ".cctor") || owner.Definition.RawSizes.thread_static_fields_size != 0
+            || !ReferenceEquals(method.AppContext, app) || !ReferenceEquals(method.DeclaringType, owner)
+            || method.Definition == null || !method.IsStatic || method.IsVirtual || method.IsAbstract
+            || method.UnderlyingPointer == 0 || method.Visibility != MethodAttributes.Public || method.GenericParameters.Count != 0
+            || method.Parameters.Count != 0 || !ReferenceEquals(method.ReturnType, field.FieldType)
+            || !owner.Properties.Any(p => ReferenceEquals(p.Getter, method))
+            || !app.MethodsByAddress.TryGetValue(method.UnderlyingPointer, out var aliases)
+            || aliases.Count != 1 || !ReferenceEquals(aliases[0], method)
+            || !TryEncoding(field.FieldType, false, out var load, out var width)
+            || field.Offset % width != 0 || field.Offset / width > 4095
+            || owner.Definition.RawSizes.static_fields_size < field.Offset + width
+            || !LegacyArm64ValueThisThunks.TryGetExactBodyRange(method, out var length) || length != 84)
+            return false;
+
+        var binary = app.Binary;
+        var bytes = binary.GetRawBinaryContent();
+        if (bytes.Length < 0x40 || !binary.TryMapVirtualAddressToRaw(method.UnderlyingPointer, out var raw)
+            || raw < 0 || raw > bytes.Length - length)
+            return false;
+        var writable = BinaryPrimitives.ReadUInt32LittleEndian(bytes.Slice(0x34, 4));
+        var writableEnd = (ulong)writable + BinaryPrimitives.ReadUInt32LittleEndian(bytes.Slice(0x38, 4))
+            + BinaryPrimitives.ReadUInt32LittleEndian(bytes.Slice(0x3c, 4));
+        if (!TryDecodeStaticGetter(bytes.Slice((int)raw, length), method.UnderlyingPointer,
+            app.GetOrCreateKeyFunctionAddresses().il2cpp_codegen_initialize_method, load, width, field.Offset,
+            writable, writableEnd, out var typeGot))
+            return false;
+
+        // ADRP/LDR obtains a GOT pointer to a registered legacy type-usage slot;
+        // the following native LDR reads that slot's resolved Il2CppClass*.
+        try
+        {
+            if (!binary.TryMapVirtualAddressToRaw(typeGot, out _)) return false;
+            var slot = binary.ReadPointerAtVirtualAddress(typeGot);
+            return app.LibCpp2IlContext.GetTypeGlobalByAddress(slot) is { } type
+                && ReferenceEquals(app.ResolveIl2CppType(type), owner);
+        }
+        catch (Exception) { return false; }
+    }
+
+    /// <summary>Instruction-only witness; exact FDE and type-global identity are required by the caller.</summary>
+    public static bool TryDecodeStaticGetter(ReadOnlySpan<byte> body, ulong start, ulong metadataInitializer,
+        uint loadOpcode, int width, int fieldOffset, ulong writableStart, ulong writableEnd, out ulong typeGot)
+    {
+        typeGot = 0;
+        if (body.Length != 84 || start % 4 != 0 || width is not (1 or 2 or 4 or 8)
+            || fieldOffset < 0 || fieldOffset % width != 0 || fieldOffset / width > 4095)
+            return false;
+        var words = new uint[21];
+        for (var i = 0; i < words.Length; i++) words[i] = BinaryPrimitives.ReadUInt32LittleEndian(body.Slice(i * 4, 4));
+        if (words[0] != 0xF81E0FF3 || words[1] != 0xA9017BFD || words[2] != 0x910043FD
+            || words[5] != 0x39401268 || words[6] != 0x370000E8 || words[9] != 0xB9400100
+            || words[11] != 0x320003E8 || words[12] != 0x39001268 || words[15] != 0xF9400108
+            || words[16] != 0xA9417BFD || words[17] != 0xF9405D08
+            || words[18] != (loadOpcode | (uint)(fieldOffset / width) << 10 | 8u << 5)
+            || words[19] != 0xF84207F3 || words[20] != 0xD65F03C0)
+            return false;
+        var guards = LegacyArm64InitializationPattern.Match(body, start, metadataInitializer, writableStart, writableEnd);
+        if (guards.Count != 1 || guards[0].Branch != start + 24 || guards[0].Skip != start + 52
+            || (words[13] & 0x9F00001F) != 0x90000008 || (words[14] & 0xFFC003FF) != 0xF9400108)
+            return false;
+        var immediate = ((words[13] >> 29) & 3) | (((words[13] >> 5) & 0x7FFFF) << 2);
+        var pageOffset = ((long)((int)(immediate << 11) >> 11)) << 12;
+        var page = unchecked((ulong)((long)((start + 52) & ~0xFFFUL) + pageOffset));
+        typeGot = page + ((words[14] >> 10) & 0xFFF) * 8UL;
+        return typeGot % 8 == 0;
+    }
+
+    public static MethodAnalysisContext? Find(FieldAnalysisContext field, bool write)
+    {
+        var pair = Cache.GetValue(field.AppContext, _ => new()).GetOrAdd(field, Build);
+        return write ? pair.Setter : pair.Getter;
+    }
+
+    private static Accessors Build(FieldAnalysisContext field)
+    {
+        MethodAnalysisContext? FindOne(bool write) => field.DeclaringType.Properties
+            .Select(property => write ? property.Setter : property.Getter)
+            .FirstOrDefault(method => method != null && IsExactLeaf(field, method, write));
+        return new Accessors(FindOne(false), FindOne(true));
+    }
+
+    /// <summary>Uncached proof predicate, also used by the independent probe.</summary>
+    public static bool IsExactLeaf(FieldAnalysisContext field, MethodAnalysisContext method, bool write)
+    {
+        var owner = field.DeclaringType;
+        if (field.AppContext.Binary is not NsoFile || field.AppContext.MetadataVersion != 24f
+            || field.IsStatic || field.Offset < 16 || owner.Definition == null
+            || owner.IsValueType || owner.IsEnumType || owner is GenericInstanceTypeAnalysisContext
+            || owner.GenericParameters.Count != 0 || owner.HasAnyGenericParameters()
+            || owner.Definition.PackingSize != 0
+            || (owner.Attributes & TypeAttributes.LayoutMask) == TypeAttributes.ExplicitLayout
+            || owner.DeclaringAssembly.Name is not ("Assembly-CSharp" or "Assembly-CSharp-firstpass")
+            || (owner.Methods.Any(candidate => candidate.Name == ".cctor")
+                && (owner.Attributes & TypeAttributes.BeforeFieldInit) == 0)
+            || !ReferenceEquals(method.AppContext, field.AppContext)
+            || !ReferenceEquals(method.DeclaringType, owner) || method.Definition == null
+            || method.IsStatic || method.IsVirtual || method.IsAbstract || method.UnderlyingPointer == 0
+            || method.Visibility != MethodAttributes.Public || method.GenericParameters.Count != 0
+            || !owner.Properties.Any(property => ReferenceEquals(write ? property.Setter : property.Getter, method)))
+            return false;
+
+        if (write)
+        {
+            if ((field.Attributes & (FieldAttributes.InitOnly | FieldAttributes.Literal)) != 0
+                || !method.IsVoid || method.Parameters.Count != 1
+                || !ReferenceEquals(method.Parameters[0].ParameterType, field.FieldType)) return false;
+        }
+        else if (method.Parameters.Count != 0 || !ReferenceEquals(method.ReturnType, field.FieldType)) return false;
+
+        if (!TryEncoding(field.FieldType, write, out var opcode, out var size)
+            || field.Offset % size != 0 || field.Offset / size > 4095
+            || owner.Definition.RawSizes.instance_size < field.Offset + size) return false;
+
+        // A two-instruction prefix with an unconditional RET has no later
+        // reachable instructions. Padding or aliases after RET are immaterial.
+        var start = method.UnderlyingPointer;
+        var next = method.AppContext.GetAddressOfNextFunctionStart(start);
+        if (next != 0 && next < start + 8) return false;
+        var raw = method.AppContext.Binary.MapVirtualAddressToRaw(start);
+        var bytes = method.AppContext.Binary.GetRawBinaryContent();
+        if (raw < 0 || raw > bytes.Length - 8) return false;
+        var span = bytes.Slice((int)raw, 8);
+        var expected = opcode | (uint)(field.Offset / size) << 10;
+        return BinaryPrimitives.ReadUInt32LittleEndian(span) == expected
+            && BinaryPrimitives.ReadUInt32LittleEndian(span[4..]) == 0xD65F03C0; // RET X30
+    }
+
+    private static bool TryEncoding(TypeAnalysisContext type, bool write, out uint opcode, out int size)
+    {
+        opcode = 0;
+        size = 0;
+        if (type is WrappedTypeAnalysisContext or GenericInstanceTypeAnalysisContext
+            || type.GenericParameters.Count != 0 || type.HasAnyGenericParameters() || type.IsEnumType) return false;
+        (uint load, uint store, int width) = type.FullName switch
+        {
+            "System.Boolean" or "System.Byte" => (0x39400000u, 0x39000001u, 1),
+            "System.SByte" => (0x39C00000u, 0x39000001u, 1),
+            "System.Char" or "System.UInt16" => (0x79400000u, 0x79000001u, 2),
+            "System.Int16" => (0x79C00000u, 0x79000001u, 2),
+            "System.Int32" or "System.UInt32" => (0xB9400000u, 0xB9000001u, 4),
+            "System.Int64" or "System.UInt64" or "System.IntPtr" or "System.UIntPtr" => (0xF9400000u, 0xF9000001u, 8),
+            "System.Single" => (0xBD400000u, 0xBD000000u, 4),
+            "System.Double" => (0xFD400000u, 0xFD000000u, 8),
+            _ when !type.IsValueType && type.Definition != null => (0xF9400000u, 0xF9000001u, 8),
+            _ => (0u, 0u, 0)
+        };
+        opcode = write ? store : load;
+        size = width;
+        return size != 0;
+    }
+}
diff --git a/Cpp2IL.Core/Utils/LegacyArm64AggregateLeaves.cs b/Cpp2IL.Core/Utils/LegacyArm64AggregateLeaves.cs
new file mode 100644
--- /dev/null
+++ b/Cpp2IL.Core/Utils/LegacyArm64AggregateLeaves.cs
@@ -0,0 +1,117 @@
+using System;
+using System.Buffers.Binary;
+using System.Linq;
+using System.Reflection;
+using Cpp2IL.Core.Model.Contexts;
+
+namespace Cpp2IL.Core.Utils;
+
+/// <summary>
+/// Exact native leaf copies of a metadata-validated 16-byte integer value field.
+/// This deliberately does not implement the general ARM64 integer aggregate ABI.
+/// </summary>
+public static class LegacyArm64AggregateLeaves
+{
+    public sealed record Match(FieldAnalysisContext Field, bool IsSetter);
+
+    /// <summary>Validate a straight-line entry ending in RET before the next function boundary.</summary>
+    public static Match? Describe(MethodAnalysisContext method)
+    {
+        if (!LegacyArm64Hfa.Enabled(method) || method.IsStatic || method.DeclaringType?.IsValueType != false)
+            return null;
+        var binary = method.AppContext.Binary;
+        if (!binary.TryMapVirtualAddressToRaw(method.UnderlyingPointer, out var raw)) return null;
+        var content = binary.GetRawBinaryContent();
+        if (raw < 0 || raw + 12 > content.Length) return null;
+        var first = BinaryPrimitives.ReadUInt32LittleEndian(content.Slice((int)raw, 4));
+        // The only accepted entry sequences end unconditionally in RET. No branch/call can
+        // reach a later instruction; alignment bytes after that RET are not executable body.
+        if ((first & 0xFFC07FFF) is not (0xA9000801 or 0xA9400408)) return null;
+        var length = (first & 0xFFC07FFF) == 0xA9000801 ? 8 : 12;
+        var next = method.AppContext.GetAddressOfNextFunctionStart(method.UnderlyingPointer);
+        if (next < method.UnderlyingPointer + (ulong)length) return null;
+        return Describe(method, content.Slice((int)raw, length));
+    }
+
+    /// <param name="body">The complete decoded native body, including its RET;
+    /// do not pass a truncated prefix of a longer function.</param>
+    public static Match? Describe(MethodAnalysisContext method, ReadOnlySpan<byte> body)
+    {
+        if (!LegacyArm64Hfa.Enabled(method) || method.IsStatic || method.IsAbstract
+            || method.GenericParameters.Count != 0
+            || method.DeclaringType is not { } owner || owner.IsValueType
+            || owner is GenericInstanceTypeAnalysisContext || owner.GenericParameters.Count != 0
+            || owner.Definition == null || owner.Definition.PackingSize != 0
+            || (owner.Attributes & TypeAttributes.LayoutMask) == TypeAttributes.ExplicitLayout)
+            return null;
+
+        bool setter;
+        uint pair;
+        if (body.Length == 8 && method.IsVoid && method.Parameters.Count == 1
+            && BinaryPrimitives.ReadUInt32LittleEndian(body[4..]) == 0xD65F03C0)
+        {
+            // STP X1,X2,[X0,#imm7*8]; RET. Offset mode only; no writeback.
+            pair = BinaryPrimitives.ReadUInt32LittleEndian(body);
+            if ((pair & 0xFFC07FFF) != 0xA9000801) return null;
+            setter = true;
+        }
+        else if (body.Length == 12 && !method.IsVoid && method.Parameters.Count == 0
+            && BinaryPrimitives.ReadUInt32LittleEndian(body[4..]) == 0xAA0803E0
+            && BinaryPrimitives.ReadUInt32LittleEndian(body[8..]) == 0xD65F03C0)
+        {
+            // LDP X8,X1,[X0,#imm7*8]; MOV X0,X8; RET.
+            pair = BinaryPrimitives.ReadUInt32LittleEndian(body);
+            if ((pair & 0xFFC07FFF) != 0xA9400408) return null;
+            setter = false;
+        }
+        else return null;
+
+        var immediate = (int)((pair >> 15) & 0x7F);
+        if ((immediate & 0x40) != 0) immediate -= 0x80;
+        var offset = immediate * 8;
+        if (offset < 16 || owner.Definition.RawSizes.instance_size < offset + 16) return null;
+        var fields = owner.Fields.Where(field => !field.IsStatic
+            && (field.Attributes & FieldAttributes.Literal) == 0 && field.Offset == offset).ToArray();
+        if (fields.Length != 1) return null;
+        var field = fields[0];
+        var signatureType = setter ? method.Parameters[0].ParameterType : method.ReturnType;
+        if (!ReferenceEquals(signatureType, field.FieldType)
+            || (setter && (field.Attributes & FieldAttributes.InitOnly) != 0)
+            || !IsKnownIntegerValue(field.FieldType)) return null;
+        return new Match(field, setter);
+    }
+
+    private static bool IsKnownIntegerValue(TypeAnalysisContext type)
+    {
+        if (!type.IsValueType || type.IsEnumType || type is WrappedTypeAnalysisContext
+            || type is GenericInstanceTypeAnalysisContext || type.GenericParameters.Count != 0
+            || type.Definition == null || type.Definition.PackingSize != 0
+            || (type.Attributes & TypeAttributes.LayoutMask) != TypeAttributes.SequentialLayout
+            || TypeSizes.UnboxedSize(type, 8) != 16) return false;
+        var fields = type.Fields.Where(field => !field.IsStatic
+            && (field.Attributes & FieldAttributes.Literal) == 0).OrderBy(field => field.Offset).ToArray();
+        if (fields.Length == 0) return false;
+        long end = 0, alignment = 1;
+        foreach (var field in fields)
+        {
+            // No references, nested structs, open generics or unknown widths.
+            var size = field.FieldType.FullName switch
+            {
+                "System.Boolean" or "System.Byte" or "System.SByte" => 1,
+                "System.Int16" or "System.UInt16" or "System.Char" => 2,
+                "System.Int32" or "System.UInt32" => 4,
+                "System.Int64" or "System.UInt64" => 8,
+                _ => 0
+            };
+            if (size == 0 || field.Offset < end || field.Offset % size != 0
+                || field.Offset + size > 16) return false;
+            // Validate ordinary sequential placement, including only required padding.
+            var expected = (end + size - 1) & -size;
+            if (field.Offset != expected) return false;
+            end = field.Offset + size;
+            alignment = Math.Max(alignment, size);
+        }
+        // Tail padding is not a managed field; field-copy semantics preserve all fields.
+        return ((end + alignment - 1) & -alignment) == 16;
+    }
+}
diff --git a/Cpp2IL.Core/Utils/LegacyArm64ValueThisThunks.cs b/Cpp2IL.Core/Utils/LegacyArm64ValueThisThunks.cs
new file mode 100644
--- /dev/null
+++ b/Cpp2IL.Core/Utils/LegacyArm64ValueThisThunks.cs
@@ -0,0 +1,322 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Runtime.CompilerServices;
+using Cpp2IL.Core.Model.Contexts;
+using LibCpp2IL.NintendoSwitch;
+
+namespace Cpp2IL.Core.Utils;
+
+/// <summary>Opt-in exact boxed-value receiver adjustors; registered metadata pointers remain unchanged.</summary>
+public static class LegacyArm64ValueThisThunks
+{
+    public sealed record Mapping(MethodAnalysisContext Method, ulong RegisteredAddress, ulong Address, int Size);
+    public sealed record Rejection(ulong RegisteredAddress, ulong Target, string Reason);
+    private sealed class State
+    {
+        public readonly Dictionary<MethodAnalysisContext, Mapping> Mappings = new();
+        public readonly List<Rejection> Rejections = new();
+        public FrameTable? Frames;
+        public string? FrameError;
+    }
+    private static readonly ConditionalWeakTable<ApplicationAnalysisContext, State> States = new();
+
+    public static ulong AnalysisAddress(MethodAnalysisContext method) => TryGetBody(method, out var address, out _) ? address : method.UnderlyingPointer;
+
+    public static bool TryGetBody(MethodAnalysisContext method, out ulong address, out int size)
+    {
+        address = method.UnderlyingPointer; size = 0;
+        if (!LegacyArm64Hfa.Enabled(method) || !States.TryGetValue(method.AppContext, out var state)
+            || !state.Mappings.TryGetValue(method, out var match)) return false;
+        address = match.Address; size = match.Size; return true;
+    }
+
+    /// <summary>
+    /// Proves only the FDE extent at the original registered native pointer. It does not
+    /// select a replacement body, establish a managed identity, or register an alias.
+    /// </summary>
+    public static bool TryGetExactBodyRange(MethodAnalysisContext method, out int size)
+        => TryGetExactBodyRange(method.AppContext, method.UnderlyingPointer, out size);
+
+    /// <summary>Bounds-only lookup for a reviewed native address, including unregistered constructors.</summary>
+    public static bool TryGetExactBodyRange(ApplicationAnalysisContext app, ulong originalAddress, out int size)
+    {
+        size = 0;
+        if (Environment.GetEnvironmentVariable("CPP2IL_LEGACY_HFA") != "1" || app.Binary is not NsoFile || app.MetadataVersion != 24f
+            || !States.TryGetValue(app, out var state)
+            || state.Frames is not { } frames) return false;
+        // Frame/CIE caches are populated lazily. Preparation is single-threaded and publishes
+        // only the completed state; ordinary-method queries can subsequently run in parallel.
+        lock (frames) return frames.TryRange(originalAddress, out size);
+    }
+
+    /// <summary>
+    /// Proves an exact registered-address extent with a plain zR CIE and empty FDE
+    /// augmentation. This is a conservative eligibility gate, not exception analysis.
+    /// Use the address overload explicitly for a selected unboxed analysis body.
+    /// </summary>
+    public static bool TryGetExactPlainBodyRange(MethodAnalysisContext method, out int size)
+        => TryGetExactPlainBodyRange(method.AppContext, method.UnderlyingPointer, out size);
+
+    /// <summary>Plain-frame eligibility at the exact supplied native address; never selects an identity or alias.</summary>
+    public static bool TryGetExactPlainBodyRange(ApplicationAnalysisContext app, ulong nativeAddress, out int size)
+    {
+        size = 0;
+        if (Environment.GetEnvironmentVariable("CPP2IL_LEGACY_HFA") != "1" || app.Binary is not NsoFile || app.MetadataVersion != 24f
+            || !States.TryGetValue(app, out var state) || state.Frames is not { } frames) return false;
+        lock (frames) return frames.TryPlainRange(nativeAddress, out size);
+    }
+
+    public static IReadOnlyList<Mapping> AcceptedMappings(ApplicationAnalysisContext app) => States.TryGetValue(app, out var state) ? state.Mappings.Values.ToArray() : [];
+    public static IReadOnlyList<Rejection> Rejections(ApplicationAnalysisContext app) => States.TryGetValue(app, out var state) ? state.Rejections.ToArray() : [];
+    public static string? FrameError(ApplicationAnalysisContext app) => States.TryGetValue(app, out var state) ? state.FrameError : null;
+    public static IEnumerable<ulong> AcceptedAnalysisAddresses(ApplicationAnalysisContext app) => AcceptedMappings(app).Select(match => match.Address);
+
+    // Exposed for instruction-boundary negative fixtures; acceptance also requires metadata and exact FDEs.
+    public static bool TryDecodeWords(uint first, uint second, ulong registeredAddress, out ulong target)
+    {
+        target = 0;
+        if (first != 0x91004000 || (second & 0xFC000000) != 0x14000000 || registeredAddress % 4 != 0) return false;
+        long immediate = second & 0x3FFFFFF;
+        if ((immediate & 0x2000000) != 0) immediate -= 0x4000000;
+        long result;
+        try { result = checked((long)registeredAddress + 4 + immediate * 4); }
+        catch (OverflowException) { return false; }
+        if (result < 0 || (ulong)result == registeredAddress) return false;
+        target = (ulong)result; return true;
+    }
+
+    private static bool HasOrdinaryValueReceiver(MethodAnalysisContext method) => method.Definition != null
+        && !method.IsStatic && !method.IsAbstract && method.GenericParameters.Count == 0
+        && method.DeclaringType is { IsValueType: true, IsEnumType: false } owner
+        && owner.Definition != null && owner is not (GenericInstanceTypeAnalysisContext or WrappedTypeAnalysisContext)
+        && owner.GenericParameters.Count == 0 && owner.Definition.RawSizes.instance_size > 16
+        && !method.ReturnType.HasAnyGenericParameters() && method.Parameters.All(parameter => !parameter.ParameterType.HasAnyGenericParameters());
+
+    /// <summary>Run after assemblies/SystemTypes exist and before raw-byte or key-function analysis.</summary>
+    public static void Prepare(ApplicationAnalysisContext app, IReadOnlyList<MethodAnalysisContext> methods)
+    {
+        var state = new State();
+        if (States.TryGetValue(app, out _)) throw new InvalidOperationException("Value-this preparation must run once per application");
+        if (Environment.GetEnvironmentVariable("CPP2IL_LEGACY_HFA") != "1" || app.Binary is not NsoFile binary || app.MetadataVersion != 24f)
+        { States.Add(app, state); return; }
+        FrameTable frames;
+        try { frames = new FrameTable(binary); }
+        catch (Exception error) when (error is InvalidDataException or OverflowException or ArgumentException)
+        { state.FrameError = error.Message; States.Add(app, state); return; }
+        state.Frames = frames;
+        var registered = methods.Select(method => method.UnderlyingPointer)
+            .Concat(binary.ConcreteGenericImplementationsByAddress.Keys).Concat(binary.AllCustomAttributeGenerators).ToHashSet();
+        var registeredCounts = methods.GroupBy(method => method.UnderlyingPointer).ToDictionary(group => group.Key, group => group.Count());
+        var candidates = new List<Mapping>();
+        foreach (var method in methods)
+        {
+            if (!HasOrdinaryValueReceiver(method)) continue;
+            ulong pointer = method.UnderlyingPointer;
+            if (!frames.IsText(pointer, 8)) continue;
+            var bytes = frames.Read(pointer, 8);
+            if (!TryDecodeWords(BinaryPrimitives.ReadUInt32LittleEndian(bytes), BinaryPrimitives.ReadUInt32LittleEndian(bytes[4..]), pointer, out var target)) continue;
+            if (!frames.TryRange(pointer, out int wrapperSize) || wrapperSize != 8 || !frames.TryRange(target, out int bodySize))
+            { state.Rejections.Add(new(pointer, target, "Missing or conflicting exact wrapper/body FDE range")); continue; }
+            if (registeredCounts[pointer] != 1 || binary.ConcreteGenericImplementationsByAddress.ContainsKey(pointer)
+                || binary.AllCustomAttributeGenerators.Contains(pointer))
+            { state.Rejections.Add(new(pointer, target, "Registered wrapper has ambiguous metadata/generic/attribute identities")); continue; }
+            if (registered.Contains(target))
+            { state.Rejections.Add(new(pointer, target, "Target already has a registered method/generic/attribute identity")); continue; }
+            candidates.Add(new(method, pointer, target, bodySize));
+        }
+        foreach (var group in candidates.GroupBy(candidate => candidate.Address))
+        {
+            if (group.Count() != 1)
+            {
+                foreach (var candidate in group) state.Rejections.Add(new(candidate.RegisteredAddress, candidate.Address, "Shared native body has ambiguous managed identity/signature"));
+                continue;
+            }
+            var match = group.Single(); state.Mappings.Add(match.Method, match);
+        }
+        States.Add(app, state); // Publish only a complete immutable preparation result.
+    }
+
+    /// <summary>Run after ordinary and generic registrations, before method analysis starts.</summary>
+    public static void RegisterAliases(ApplicationAnalysisContext app)
+    {
+        if (!States.TryGetValue(app, out var state)) return;
+        foreach (var match in state.Mappings.Values.ToArray())
+        {
+            if (app.MethodsByAddress.TryGetValue(match.Address, out var previous) && previous.Count != 0)
+            {
+                if (previous.Count == 1 && ReferenceEquals(previous[0], match.Method)) continue;
+                state.Mappings.Remove(match.Method);
+                state.Rejections.Add(new(match.RegisteredAddress, match.Address, "Late alias conflicts with an existing managed target"));
+                // Constructor preparation only: no method analysis has happened yet.
+                match.Method.RawBytes = BinarySlice.Empty;
+                match.Method.EnsureRawBytes();
+                continue;
+            }
+            app.MethodsByAddress[match.Address] = [match.Method];
+        }
+    }
+
+    // Bounded NSO64/MOD0 eh_frame_hdr lookup. Validates table/FDE/CIE agreement;
+    // it does not interpret CFI, LSDA actions, personalities, or exception semantics.
+    private sealed class FrameTable
+    {
+        private readonly NsoFile binary;
+        private readonly (ulong Raw, ulong Address, ulong Size)[] segments;
+        private readonly ulong headerStart, headerEnd, frameStart, roEnd;
+        private readonly Dictionary<ulong, ulong> fdes = new();
+        private readonly ulong[] starts;
+        private readonly record struct FrameRange(int Size, bool Plain);
+        private readonly record struct CieDescription(byte Encoding, bool Plain);
+        private readonly Dictionary<ulong, FrameRange> ranges = new();
+        private readonly Dictionary<ulong, CieDescription> cies = new();
+
+        public FrameTable(NsoFile binary)
+        {
+            this.binary = binary;
+            var raw = binary.GetRawBinaryContent();
+            int rawLength = raw.Length;
+            if (raw.Length < 0x100 || BinaryPrimitives.ReadUInt32LittleEndian(raw) != 0x304F534E) throw new InvalidDataException("Expected NSO header");
+            segments = new[] { 0x10, 0x20, 0x30 }.Select(offset =>
+            {
+                var content = binary.GetRawBinaryContent();
+                return ((ulong)BinaryPrimitives.ReadUInt32LittleEndian(content[offset..]),
+                    (ulong)BinaryPrimitives.ReadUInt32LittleEndian(content[(offset+4)..]),
+                    (ulong)BinaryPrimitives.ReadUInt32LittleEndian(content[(offset+8)..]));
+            }).ToArray();
+            if (segments.Any(segment => segment.Raw < 0x100 || segment.Raw + segment.Size > (ulong)rawLength || segment.Address + segment.Size > 0x100000000UL))
+                throw new InvalidDataException("NSO segment bounds differ");
+            ulong mod = U32(4);
+            if (U32(mod) != 0x30444F4D) throw new InvalidDataException("Missing MOD0");
+            headerStart = Relative(mod, I32(mod+16)); headerEnd = Relative(mod, I32(mod+20));
+            roEnd = segments[1].Address + segments[1].Size;
